# YALF project .gitattributes
# Auto detect text files and perform LF normalization
* text=auto

# YALF dictionary files
*.yalf text eol=lf linguist-language=YAML
*.yaml text eol=lf
*.yml text eol=lf

# Documentation - явно помечаем как документацию
*.md text eol=lf linguist-detectable
*.txt text eol=lf

# README файлы - важны для GitHub
README* text eol=lf linguist-detectable
CHANGELOG* text eol=lf linguist-detectable
CONTRIBUTING* text eol=lf linguist-detectable

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf

# JSON files
*.json text eol=lf

# Config files
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Linguist overrides for GitHub language statistics
# Документация не учитывается в статистике языков
docs/** linguist-documentation
examples/** linguist-documentation

# Export ignore
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
