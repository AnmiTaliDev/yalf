# YALF project .gitattributes
# Auto detect text files and perform LF normalization
* text=auto

*.yalf text eol=lf linguist-language=YAML linguist-detectable=true
*.yaml text eol=lf linguist-detectable=true
*.yml text eol=lf linguist-detectable=true

*.md text eol=lf linguist-detectable=true
*.txt text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf

# JSON files
*.json text eol=lf

.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
