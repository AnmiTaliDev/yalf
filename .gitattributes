# YALF project .gitattributes
# Auto detect text files and perform LF normalization
* text=auto

# YALF dictionary files - показываем как YAML в статистике
*.yalf text eol=lf linguist-language=YAML linguist-detectable
*.yaml text eol=lf linguist-detectable
*.yml text eol=lf linguist-detectable

# Documentation - показываем Markdown в статистике
*.md text eol=lf linguist-detectable

# Остальные файлы
*.txt text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf

# JSON files
*.json text eol=lf

# Config files
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# УБРАЛИ linguist-documentation, чтобы файлы учитывались в статистике
# Если хотите исключить только определённые папки:
# tests/** linguist-vendored
# vendor/** linguist-vendored

# Export ignore
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
